{
	"name": "ui",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"test:e2e": "node --test tests/e2e.mjs"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@vitest/browser-playwright": "^4.1.8",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"engines": {
		"node": ">=22.17"
	},
	"dependencies": {
		"@atlaskit/pragmatic-drag-and-drop": "^4.0.0",
		"@atlaskit/pragmatic-drag-and-drop-auto-scroll": "^3.2.1",
		"@atlaskit/pragmatic-drag-and-drop-hitbox": "^3.0.0",
		"@atlaskit/pragmatic-drag-and-drop-live-region": "^2.1.0"
	}
}
